# 依赖安装树。peer 与 devDependencies 只在本机安装，不进入版本库。
node_modules/

# npm / pnpm pack 产物与包管理器缓存。锁文件若出现应提交，此处不忽略。
*.tgz
.npm/
.pnpm-store/

# lib/client.js 是发布用预构建浏览器包（package.json 的 files 与 exports["./client"]）。
# 由 src/client.js 经 npm run build 生成；更新后应提交，不要忽略 lib/。

# 意外的构建目录。发布用的浏览器包在 lib/，不在 dist/。
/dist/

# 本地环境与凭据。Tavily 密钥只放在环境变量或 ~/.dsh/.credentials.yaml。
.env
.env.*
!.env.example
*.local
*.key
*.pem

# 本机 DSH 测试家目录、会话和报告
.dsh/
.dsh-*/
.dsh-home/
.dsh-report/

# 日志、覆盖率和工具缓存
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
coverage/
.nyc_output/
*.lcov
.eslintcache
.cache/
*.tsbuildinfo

# 操作系统与编辑器临时文件
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
Desktop.ini
ehthumbs.db
*:Zone.Identifier
*.swp
*.swo
*~
*.orig
*.rej
.idea/
.vscode/
*.code-workspace
